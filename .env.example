PORT=5002
PUBLIC_URL=https://api.example.com
MONGO_URI=mongodb://localhost:27017/voter_management
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-random-secret
ALLOW_INMEMORY_DB=false

# Optional bootstrap administrators (only used if DB has no matching admin yet)
MASTER_ADMIN_USERNAME=
MASTER_ADMIN_PASSWORD=
MASTER_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PHONE=

# Meta WhatsApp Cloud API
META_WHATSAPP_TOKEN=
META_PHONE_ID=
META_WABA_ID=
META_GRAPH_API_VERSION=v20.0
META_WEBHOOK_VERIFY_TOKEN=replace-with-webhook-verify-token
META_APP_SECRET=

# Cloudinary photo storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Support contact metadata shown on suspension notice
SUPPORT_BRAND_NAME=VijaySetu Support
SUPPORT_PHONE=

# Automated rolling backup retention
MAX_DB_BACKUPS=14
E2E_TEST_MONGO_URI=mongodb://127.0.0.1:27017/vijaysetu_e2e_test
